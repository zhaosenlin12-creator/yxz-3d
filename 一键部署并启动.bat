@echo off
chcp 936 >nul
title 宜小智工作台 - 一键部署并启动
cd /d "%~dp0"

echo ============================================================
echo   宜小智工作台 - 一键部署并启动
echo ============================================================
echo   1) 自检依赖：缺什么装什么，已装过的自动跳过
echo   2) 从 keys.txt 生成前端服务商配置（LLM / TTS / 语音链）
echo   3) 拉起后端 / 前端 / 本地语音包 / WS 通道
echo   4) 自动打开浏览器
echo.
echo   首次运行需联网下载依赖（Node 依赖 + Python 环境 + AI 权重）
echo   约 2-4GB，看网速 10-40 分钟；装完后可离线使用。
echo   已有依赖的机器 30 秒内起来。
echo ============================================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0start-all.ps1" %*

if errorlevel 1 (
    echo.
    echo ============================================================
    echo   [FAIL] 启动失败
    echo ============================================================
    echo   1. 看 .run 目录下的日志（backend / frontend / runtime）
    echo   2. 运行 verify-install.ps1 做整机体检
    echo   3. 端口被占用时先跑 stop-all.ps1 再启动
    echo ============================================================
    echo.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   [OK] 启动完成
echo   前端   http://127.0.0.1:5199
echo   后端   http://127.0.0.1:8000
echo   本地语音 http://127.0.0.1:17493
echo   停止服务：运行「停止服务.bat」或 stop-all.ps1
echo ============================================================
echo.
pause
