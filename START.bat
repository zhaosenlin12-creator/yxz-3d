@echo off
title 宜小智工作台
color 0B

echo.
echo ============================================================
echo   宜小智工作台 - 专业 AI 创作工作站
echo ============================================================
echo.
echo   正在启动后端服务 (FastAPI  :8000) 与前端界面 (Vue3+3D :5199)
echo   请稍候，每步会显示 [OK] / [FAIL]，浏览器将自动打开...
echo   首次使用请先运行 INSTALL-FIRST-TIME.bat 安装依赖
echo ============================================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0start-all.ps1" %*

if errorlevel 1 (
    color 0C
    echo.
    echo ============================================================
    echo   启动失败！
    echo ============================================================
    echo.
    echo   常见问题排查：
    echo   1. 首次使用？请运行 INSTALL-FIRST-TIME.bat
    echo   2. 端口被占用？关闭其他程序后重试
    echo   3. 查看详细错误：检查 .run 文件夹中的日志
    echo   4. 详见 README.md「常见问题」表
    echo.
    echo ============================================================
    pause
) else (
    color 0A
    echo.
    echo ============================================================
    echo   启动成功！
    echo ============================================================
    echo.
    echo   前端界面: http://127.0.0.1:5199
    echo   后端 API: http://127.0.0.1:8000
    echo.
    echo   浏览器已自动打开，开始体验吧！
    echo   关闭此窗口将停止服务
    echo.
    echo ============================================================
    echo.
    pause >nul
)
